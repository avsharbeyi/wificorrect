[Unit]
Description=WifiCorrect yönetim merkezi: arşivlerden günlük sayılar ve gün özetleri

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/sbin/wc-istatistik
# Kafeden gelen bozuk bir dosya görevi sonsuza dek bekletmesin (timer bir daha tetiklenemezdi)
TimeoutStartSec=2h
