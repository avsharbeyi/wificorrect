# Musteri tarafi kopru (Adim 2). Wi-Fi (wlp2s0) ileride panelden eklenecek.
auto br-hotspot
iface br-hotspot inet static
	address 10.50.0.1/24
	bridge_ports enp1s0
	bridge_stp off
	bridge_fd 0
	bridge_waitport 0
	post-up sysctl -qw net.ipv6.conf.br-hotspot.disable_ipv6=1 net.ipv6.conf.enp1s0.disable_ipv6=1
